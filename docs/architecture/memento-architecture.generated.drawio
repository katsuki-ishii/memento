        <mxCell id="ddb-schema" value="Single Table Design&#xa;&#xa;Primary Key:&#xa;  PK: USER#&lt;cognito-sub&gt;&#xa;  SK: SETTINGS | EVENT#&lt;timestamp&gt;&#xa;&#xa;GSI1 (Week lookup):&#xa;  gsi1pk: WEEK#&lt;weekId&gt;&#xa;  gsi1sk: USER#&lt;sub&gt;#EVENT#&lt;ts&gt;&#xa;&#xa;Entities:&#xa;  UserSettings (username, birthYear,&#xa;    lifespan, weekStart, theme, locale)&#xa;  Event (weekId, title, mood, note)&#xa;&#xa;Billing Mode: On-Demand" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B48CC;strokeWidth=1;fontSize=10;fontColor=#333333;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" vertex="1" parent="ddb-group">
